{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "health-response",
  "description": "QuickBite Support contract 1.1.0 — see docs/API_CONTRACT.md",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "down"
      ]
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "contract_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "uptime_s": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "models": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "available": {
              "type": "boolean"
            },
            "latency_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "provider",
            "name",
            "available"
          ]
        },
        "fallback": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "available": {
                  "type": "boolean"
                },
                "latency_ms": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "provider",
                "name",
                "available"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "primary"
      ]
    },
    "vector_store": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "available": {
          "type": "boolean"
        },
        "document_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "chunk_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "collection": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider",
        "available",
        "document_count"
      ]
    },
    "embeddings": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "dimensions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "model"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "langfuse_enabled": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "checked_at",
    "models",
    "vector_store"
  ]
}
