# Which ChatClient the app uses: mock | live. Defaults to mock.
NEXT_PUBLIC_API_MODE=mock

# Required when NEXT_PUBLIC_API_MODE=live. May include a path prefix, e.g. https://api.example.com/v1
# If live mode is set without this, the app degrades to mock instead of failing.
NEXT_PUBLIC_API_URL=

# Mock pacing: demo (default, no cold start) | realistic (cold start + fallbacks) | instant (tests)
NEXT_PUBLIC_MOCK_PROFILE=demo

# Optional. Used to build Langfuse trace links when the backend sends only trace_id.
# Example: https://cloud.langfuse.com/project/cl0abc123
NEXT_PUBLIC_LANGFUSE_PROJECT_URL=
