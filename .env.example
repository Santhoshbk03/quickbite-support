# Where data comes from: mock (built-in demo data, the default) | live (your backend)
NEXT_PUBLIC_API_MODE=mock

# Backend base URL, used when NEXT_PUBLIC_API_MODE=live. May include a path prefix,
# e.g. http://localhost:8000 or https://api.example.com/v1. Without it the app stays on demo data.
NEXT_PUBLIC_API_URL=

# Optional. Public URL of this site, for social preview links. Vercel provides it automatically.
NEXT_PUBLIC_SITE_URL=
