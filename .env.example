# Where data comes from: mock (built-in demo data, the default) | live (the FastAPI backend)
NEXT_PUBLIC_API_MODE=mock

# Base URL the browser calls in live mode. Use the built-in proxy, because the backend doesn't
# send CORS headers: /api/backend. Without a value the app stays on demo data.
NEXT_PUBLIC_API_URL=

# Server-side only: where the /api/backend proxy forwards to, e.g. http://127.0.0.1:8000
BACKEND_URL=

# Optional. Public URL of this site, for social preview links. Vercel provides it automatically.
NEXT_PUBLIC_SITE_URL=
